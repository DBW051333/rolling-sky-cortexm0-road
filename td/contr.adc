set_pin_assignment { uart_rx } { LOCATION = F12; IOSTANDARD = LVCMOS33; }
set_pin_assignment { uart_tx } { LOCATION = D12; IOSTANDARD = LVCMOS33; }

# Board SD slot in SPI mode (board vendor reference).
set_pin_assignment { SD_CLK } { LOCATION = F15; IOSTANDARD = LVCMOS33; }
set_pin_assignment { SD_CS } { LOCATION = F13; IOSTANDARD = LVCMOS33; }
set_pin_assignment { SD_MISO } { LOCATION = D14; IOSTANDARD = LVCMOS33; }
set_pin_assignment { SD_MOSI } { LOCATION = F14; IOSTANDARD = LVCMOS33; }

# Baseboard PWM audio: two 510R/33nF stages into the PAM8403 power amp
# and the 3.5 mm jack (板卡和引脚说明.pdf 3.5).
set_pin_assignment { audio_pwm } { LOCATION = F3; IOSTANDARD = LVCMOS33; }

# EG4S20 comprehensive baseboard schematic, page 1, HDMI / P1 header.
# Native Bank 3 LVDS33 outputs; TD automatically reserves/drives the N pad.
# D0 P/N=N1/M1, D1=P4/N4, D2=J3/J4, CLK=P1/R1.
set_pin_assignment { HDMI_P[0] } { LOCATION = N1; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_P[1] } { LOCATION = P4; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_P[2] } { LOCATION = J3; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_P[3] } { LOCATION = P1; IOSTANDARD = LVDS33; }

# Keep the unused panel backlight off without a display controller.
set_pin_assignment { unused_panel_bl } { LOCATION = R2; IOSTANDARD = LVCMOS33; }
